APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Producción: APP_DEBUG=false y APP_URL=https://tu-dominio.
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Administrador inicial creado por AuthSeeder.
# En local/testing, si ADMIN_PASSWORD queda vacío se usa la contraseña demo "password".
# En producción, ADMIN_PASSWORD es obligatorio y debe cumplir la política de VUL-11.
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@sistema.com
ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# En producción Laravel cifra la sesión si SESSION_ENCRYPT=true.
# Actívalo si el contenido de sesión es sensible; invalida sesiones existentes.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Producción: SESSION_SECURE_COOKIE=true y SESSION_SAME_SITE=lax.
# Si se omite SESSION_SECURE_COOKIE, en producción se fuerza true.
# SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# API de consulta de datos vehiculares por placa (api.json.pe)
VEHICLE_API_URL=https://api.json.pe/api/placa
VEHICLE_API_TOKEN=

# API de consulta de datos DNI (api.json.pe) - reutiliza VEHICLE_API_TOKEN
DNI_API_URL=https://api.json.pe/api/dni

# WhatsApp del local para recibir pedidos del carrito (9 dígitos PE; se antepone 51)
WHATSAPP_PEDIDOS=

# Google OIDC (login público /cuenta/*). Registrar la redirect URI exacta
# en la consola de Google por entorno.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#GOOGLE_REDIRECT_URI="${APP_URL}/cuenta/auth/google/callback"
